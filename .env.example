# ==============================================================================
# KRISHNA PATIL — PORTFOLIO ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# 1. Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API (URL & Publishable Key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 2. Studio Admin Development Access Flag
# In local development, setting to "true" allows testing the dashboard directly.
# In production builds, set to "false" to enforce Supabase Auth administrator login.
VITE_DEV_ADMIN_ENABLED=false
